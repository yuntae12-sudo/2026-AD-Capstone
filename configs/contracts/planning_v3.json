  "ppo_observation": {
    "core": "core_observation",
    "candidate_commands": {
      "shape": [
        5,
        19
      ],
      "dtype": "float32"
    },
    "candidate_command_field_mask": {
      "shape": [
        5,
        19
      ],
      "dtype": "bool"
    },
