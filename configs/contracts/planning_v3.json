      "shape": [
        5
      ],
      "dtype": "bool"
    },
    "candidate_tokens": {
      "shape": [
        5
      ],
      "dtype": "string",
      "usage": "metadata only; not network inputs"
    },
    "network_binding": "gather agent/lane embeddings with valid slots; never normalize raw IDs"
  },
  "wire": {
    "optional": "{value: T or null, valid: bool}; invalid must use null",
    "token_fields": {
      "episode_uid": "str",
      "scene_id": "str",
      "sim_tick": "int64",
      "revision": "int64",
      "schema_version": "int32"
    },
    "array_order": "C row-major; raw_u index = 2*i+axis; waypoint i is future tick i+1",
    "invalid_tensor_value": 0,
    "finite_required": true,
    "ids": "int64 source IDs outside networks; -1 only for tensor slots"
  },
  "ownership": {
    "command_id": "ExecutionManager monotonically assigns episode-local int64 on accepted semantic change",
    "request_id": "provider-generated string, unique within episode",
    "candidate_token": "CommandBuilder snapshot identity, bound to observation token",
    "heartbeat": "CommandBuilder refreshes same ID; no rebinding on repeated same mode",
    "execute_authority": "ExecutionManager only; CommandBuilder requests next-tick EXECUTE after READY",
    "clock": "Environment only; submit_behavior never advances physics"
  },
  "api": {
    "reset": "reset(scene_key, seed, provider_spec) -> Boundary",
    "submit_behavior": "submit_behavior(CommandRequest, observation_token) -> Receipt + Boundary; 0 physics ticks",
    "step_waypoints": "step_waypoints(WaypointProposal, observation_token) -> StepResult + Boundary; exactly 1 physics tick",
    "step_forced": "step_forced(observation_token) -> StepResult + Boundary; exactly 1 physics tick; no fake policy action",
    "behavior_candidate_builder": "build_candidates(SceneState, ExecutionContext) -> 5 CommandDrafts + masks + binding slots",
    "ppo_policy": "select_mode(PPOObservation, key, deterministic) -> action_index int32 + selected_candidate_token",
    "sac_policy": "propose(CoreObservation, active_command, anchor, key, deterministic) -> WaypointProposal"
  },
  "sampler": {
    "mean_shape": [
      30,
      2
    ],
    "rho_shape": [
      2
    ],
    "mu_activation": "linear",
    "action_support": "R^60",
    "base": "b_i=v0_local*tau_i+0.5*a0_local*tau_i^2",
    "scale": "s_i=3*tau_i^2",
    "B": "h^3*(i-j+1)*(i-j+2)/(2*s_i) for 1<=j<=i<=30, else 0",
    "g": "clip((ego_speed_mps/2)^3,0.002,1)",
    "sigma_min": 0.005,
    "sigma_max": 0.03,
    "sigma_reference": 0.02,
    "rho_initial_bias": "log(1.5)",
    "sample": "u[:,d]=mu[:,d]+g*B@(sigma[d]*epsilon[:,d])",
    "entropy_log_density": "ell=30-0.5*sum(epsilon^2)-30*sum_d log(sigma[d]/0.02)",
    "target_entropy": 0.0,
    "sampling_dtype": "float64",
    "parameter_dtype": "float32",
    "replay_raw_u_dtype": "float64",
    "proposal_raw_u_shape": [
      30,
      2
    ],
    "replay_raw_u_shape": [
      60
    ]
  },
  "control": {
    "longitudinal_kp": 6.0,
    "longitudinal_kd": 0.1,
    "derivative_filter": 0.5,
    "preview": "clip(2/max(speed,1),0.3,1.0)",
    "L": "max(norm(p_ref-p_ego),1)",
    "curvature": "e_y/L^2+0.5*e_heading/L+0.1*filtered_de_y/(max(speed,1)*L)",
    "accel_limits": [
      -6.0,
      6.0
    ],
    "curvature_limits": [
      -0.3,
      0.3
    ],
    "jerk_limit": 20.0,
    "curvature_rate_limit": 0.5,
    "lateral_accel_limit": 4.0,
    "tracking_max_position_m": 0.75,
    "tracking_max_speed_mps": 2.0,
    "tracking_max_heading_deg": 15.0,
    "gate_position_rms_m": 0.3,
    "gate_speed_rms_mps": 1.0
  },
  "learning": {
    "gamma_per_physics_tick": 0.99,
    "sac_target_tau": 0.005,
    "sac_batch": 256,
    "sac_lr": 0.0003,
    "alpha_initial": 0.001,
    "alpha_bounds": [
      1e-06,
      0.01
    ],
    "ppo_lr": 0.0003,
    "ppo_clip": 0.2,
    "ppo_gae_lambda_per_decision": 0.95,
    "ppo_update_epochs": 10,
    "ppo_minibatch": 64,
    "ppo_rollout_decisions": 2048,
    "ppo_entropy_coef": 0.01,
    "ppo_value_coef": 0.5,
    "ppo_grad_clip": 0.5,
    "ppo_target_kl": 0.02,
    "transition": "R=sum(gamma^k*r_k), discount=gamma^delta_ticks; no fabricated action for forced ticks",
    "simultaneous_policy_training": false,
    "initial_supported_modes": [
      "KEEP",
      "FOLLOW"
    ],
    "reward_version": "shared_tick_reward_v3",
    "completion_reward_keys": {
      "STOP": "no maneuver bonus; STOP_AT_POSE episode goal pays +10 once",
      "MERGE": "target_lane_once",
      "AVOID": "target_agent_once"
    },
    "stop_dense_cost": "-.1*clip(abs(route_distance_to_stop)/30,0,1)-.2*clip(speed/10,0,1); zero in HOLD; no potential shaping",
    "reward_command": "accepted command snapshot used during that physics tick",
    "episode_goal_reward": 10.0
  },
  "defaults": {
    "preferred_speed_cap_mps": 10.0,
    "odd_speed_cap_mps": 15.0,
    "follow_min_gap_m": 3.0,
    "follow_time_gap_s": 1.5,
    "stop_comfort_decel_mps2": 2.0,
    "stop_line_margin_m": 0.5,
    "stop_position_tolerance_m": 1.0,
    "stop_speed_tolerance_mps": 0.2,
    "completion_dwell_ticks": 10,
