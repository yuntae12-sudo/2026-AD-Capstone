    "collision_prevention_margin_each_side_m": 0.3,
    "road_prevention_margin_each_side_m": 0.1,
    "effective_speed_preference": "min(active.desired_speed,current_valid_speed_limit,15)",
    "stop_task_distance_bounds_m": [
      5.0,
      60.0
    ],
    "physical_numeric_tolerance": 1e-06,
